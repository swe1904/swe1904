packages:
  yum:
    cronie: []

commands:
  remove_old_cron:
    command: "rm -f /etc/cron.d/expiry-alert /etc/cron.d/new-expiry-alert.bak"

  remove_bak_cron:
    command: "rm -f /etc/cron.d/*.bak"

files:
  "/etc/cron.d/new-expiry-alert":
    mode: "000644"
    owner: root
    group: root
    content: |
      0 0 * * * root cd /var/www/html && export $(cat /opt/elasticbeanstalk/deployment/env) && /usr/bin/php /var/www/html/console/yii expiry-alert/check-expiry >> /var/log/expiry-alert.log 2>&1

container_commands:
  01_restart_cron:
    command: "sudo systemctl restart crond"