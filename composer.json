{
  "name": "trntv/yii2-starter-kit",
  "description": "Yii2 Starter Kit Application Template",
  "keywords": [
    "yii2",
    "framework",
    "start",
    "application template",
    "yii2 advanced"
  ],
  "authors": [
    {
      "name": "Eugene Terentev",
      "email": "eugene@terentev.net",
      "homepage": "http://terentev.net",
      "role": "Developer"
    }
  ],
  "type": "project",
  "license": "BSD-3-Clause",
  "support": {
    "issues": "https://github.com/trntv/yii2-starter-kit/issues?state=open",
    "source": "https://github.com/trntv/yii2-starter-kit"
  },
  "require": {
    "php": ">=5.4.0",
    "ext-intl": "*",
    "yiisoft/yii2": "~2.0.35",
    "yiisoft/yii2-bootstrap": "~2.0",
    "yiisoft/yii2-swiftmailer": "~2.0",
    "yiisoft/yii2-authclient": "~2.0",
    "yiisoft/yii2-jui": "~2.0",
    "mihaildev/yii2-elfinder": "~1.0",
    "trntv/yii2-aceeditor": "~2.0",
    "trntv/probe": "~0.2",
    "trntv/yii2-glide": "~1.0",
    "intervention/image": "~2.1",
    "vlucas/phpdotenv": "^5.6",
    "league/glide": "~0.3",
    "bower-asset/admin-lte": "~2.0",
    "bower-asset/font-awesome": "~4.0",
    "bower-asset/html5shiv": "~3.0",
    "bower-asset/jquery-slimscroll": "~1.3",
    "bower-asset/flot": "~0.8",
    "voskobovich/yii2-many-many-behavior": "*",
    "kartik-v/yii2-mpdf": "dev-master",
    "yiisoft/yii2-imagine": "^2.0",
    "kartik-v/yii2-widget-fileinput": "@dev",
    "kartik-v/yii2-widget-select2": "@dev",
    "kartik-v/yii2-widget-datepicker": "@dev",
    "mootensai/yii2-enhanced-gii": "dev-master",
    "himiklab/yii2-sortable-grid-view-widget": "*",
    "vova07/yii2-imperavi-widget": "*",
    "kartik-v/yii2-datecontrol": "1.9.x-dev",
    "perminder-klair/yii2-dropzone": "dev-master",
    "aws/aws-sdk-php": "^3.337",
    "league/flysystem-aws-s3-v3": "^1.0@dev",
    "pragmarx/google2fa": "^8.0",
    "bacon/bacon-qr-code": "^2.0",
    "mdmsoft/yii2-admin": "2.0.0",
    "symfony/error-handler": "^6.3",
    "trntv/yii2-datetime-widget": "^1.1",
    "yii2-starter-kit/yii2-file-kit": "^2.1",
    "php-webdriver/webdriver": "^1.15",
    "codeception/codeception": "^2.1",
    "nesbot/carbon": "^2.73",
    "2amigos/yii2-tinymce-widget": "~1.0",
    "2amigos/yii2-ckeditor-widget": "~2.0"
  },
  "require-dev": {
    "yiisoft/yii2-debug": "~2.0",
    "yiisoft/yii2-codeception": "~2.0",
    "yiisoft/yii2-faker": "~2.0",
    "yiisoft/yii2-gii": "*"
  },
  "minimum-stability": "stable",
  "suggest": {
    "trntv/yii2-deploy": "dev-master@dev",
    "trntv/yii2-debug-xhprof": "dev-master@dev"
  },
  "config": {
    "process-timeout": 1800,
    "fxp-asset": {
      "enabled": false
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "extra": {
    "asset-installer-paths": {
      "npm-asset-library": "vendor/npm",
      "bower-asset-library": "vendor/bower"
    }
  }
}
