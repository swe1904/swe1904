					$tpArr = explode('^',$vs);
					if(count($tpArr) == 2){
						$arrIdNameNow[$tpArr[0]] = $tpArr[1];
					}elseif(count($tpArr) > 2){
						$tpstr = '';
						for($j=1; $j<count($tpArr); $j++){
							$tpstr .= $tpArr[$j] . ' ';
